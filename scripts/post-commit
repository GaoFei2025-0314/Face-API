#!/usr/bin/env bash
# ============================================================================
# Post-commit hook: Auto Code Review
# Each local commit triggers a background code review.
# Results saved to:  Coding Review/code-review-{version}-{date}-{commit}.md
# ============================================================================
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
COMMIT_HASH="$(git log -1 --format='%h')"
COMMIT_MSG_RAW="$(git log -1 --format='%s')"
CHANGED_FILES_RAW="$(git diff --name-only HEAD~1..HEAD 2>/dev/null || true)"

detect_review_version() {
    {
        printf '%s\n' "$COMMIT_MSG_RAW"
        printf '%s\n' "$CHANGED_FILES_RAW"
        while IFS= read -r file; do
            [ -n "$file" ] || continue
            [ -f "$REPO_ROOT/$file" ] || continue
            grep -EIoh '[Vv][0-9]+\.[0-9]+' "$REPO_ROOT/$file" 2>/dev/null || true
        done <<FILES
$CHANGED_FILES_RAW
FILES
    } | grep -Eoi 'v[0-9]+\.[0-9]+' | tr '[:lower:]' '[:upper:]' | sort -V | tail -1
}

VERSION="$(detect_review_version)"
if [ -z "$VERSION" ]; then
    # fallback to README.md when the commit does not mention a version.
    VERSION="$(grep -Eoh 'V[0-9]+\.[0-9]+' "$REPO_ROOT/README.md" 2>/dev/null | head -1 || true)"
fi
if [ -z "$VERSION" ]; then
    VERSION="unknown"
fi

DATE="$(date +%Y-%m-%d)"
OUTPUT_DIR="$REPO_ROOT/Coding Review"
OUTPUT_FILE="$OUTPUT_DIR/code-review-${VERSION}-${DATE}-${COMMIT_HASH}.md"
COMMIT_MSG="$(printf '%s' "$COMMIT_MSG_RAW" | head -c 200)"
CHANGED_FILES="$(printf '%s' "$CHANGED_FILES_RAW" | tr '\n' ' ' | head -c 500)"
if [ -z "$CHANGED_FILES" ]; then
    CHANGED_FILES="all"
fi

mkdir -p "$OUTPUT_DIR"

cd "$REPO_ROOT"

CLAUDE_PROMPT=$(cat <<PROMPT
Project: face_api, version $VERSION, at $REPO_ROOT.
Commit: $COMMIT_HASH - $COMMIT_MSG
Changed files: $CHANGED_FILES

Run a full code review (security + quality) on this commit. Read only the changed files listed above, not the entire codebase.

Output requirements:
- Save to: $OUTPUT_FILE
- Markdown format
- Header: "# Code Review Report — face_api $VERSION", Date, Commit hash, Changed files list
- Sections: CRITICAL / HIGH / MEDIUM (skip LOW)
- Each finding: file:line reference, problem description, fix suggestion
- Security checklist table at the bottom
- All text in Chinese except code identifiers

Keep it focused. Only flag real issues, not style nitpicks.
PROMPT
)

nohup claude -p "$CLAUDE_PROMPT" > /dev/null 2>&1 &

echo "[post-commit] Review started in background → $OUTPUT_FILE"
exit 0
